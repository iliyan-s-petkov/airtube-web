# Copy to .env for local development: cp .env.example .env
#
# .env is gitignored. Never commit it, and never reuse these values outside
# local development — they exist only so `docker compose up` works out of the
# box against a throwaway database.
#
# In production, supply these through your orchestrator's secret mechanism.
# The binary reads configuration from the environment only; there is no config
# file to leak and no credential compiled into it.

# Local Postgres credentials. Used by the db service to initialise the cluster
# and by the collector to reach it — change all three together.
POSTGRES_USER=airbg
POSTGRES_PASSWORD=airbg
POSTGRES_DB=airbg

# Connection string the collector uses. sslmode=disable is acceptable only
# because this never leaves the compose network. Require TLS in production.
AIRBG_DATABASE_URL=postgres://airbg:airbg@db:5432/airbg?sslmode=disable

# Optional. Defaults are applied by the binary when these are unset.
# AIRBG_UPSTREAM_URL=https://data.sensor.community/airrohr/v1/filter/country=BG
# AIRBG_POLL_INTERVAL=5m

# --- Serving (Phase 2) ---

# Public HTTP listener. Keep this on loopback and reach it through a Cloudflare
# tunnel. Binding 0.0.0.0 exposes the origin directly, and a client that reaches
# the origin directly is not covered by any Cloudflare protection — only by the
# in-process token buckets.
AIRBG_LISTEN_ADDR=127.0.0.1:8080

# Private listener: /metrics and /healthz. Never route this publicly.
AIRBG_METRICS_ADDR=127.0.0.1:9090

# Peer ranges whose CF-Connecting-IP header is believed. EMPTY MEANS TRUST
# NOBODY, which is the correct value for local development and for any origin
# not behind Cloudflare. Setting this while the origin is also directly
# reachable lets anyone who can reach it spoof their client IP and bypass every
# rate limit — restrict the origin first, then set this.
# AIRBG_TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,2400:cb00::/32

# Public origin, used for canonical and hreflang links. Must be absolute.
AIRBG_BASE_URL=http://localhost:8080

# The serve command's two connection pools. They are separate on purpose: the
# collector holds a connection for up to 60s per poll cycle while assigning
# sensors to areas, and while both workloads shared one pool, request handlers
# starved behind it on a schedule. Their sum is what Postgres sees from one
# instance, so raising either is a decision about max_connections. Both must be
# at least 1 — pgxpool reads 0 as "use max(4, numCPU)", so a 0 here would look
# like an explicit choice and silently become the host's core count.
AIRBG_DB_API_CONNS=8
AIRBG_DB_COLLECTOR_CONNS=4

# Caps how many requests may be inside a database query at once, across every
# client — a bound on the crowd, not on any one client. Rate limiting alone
# (see the series bucket) permits N well-behaved clients to collectively queue
# more concurrent database work than the pool can serve; the excess would
# otherwise wait inside pgxpool.Acquire holding a goroutine and a socket until
# the 30s WriteTimeout fires, failing most of them at once. Refusing the excess
# immediately (503, Retry-After: 2) keeps the site working for everyone else;
# queueing all of them for 30s is an outage. Must be at least 1.
AIRBG_MAX_DB_INFLIGHT=16

# Caps how many connections the PUBLIC listener holds open at once — a bound on
# sockets, not on requests. Nothing else in this process stops tens of thousands
# of mostly-idle connections, each dribbling a header byte every few seconds,
# from exhausting file descriptors and goroutines before a single request
# completes: no rate limiter or admission cap ever sees a connection that never
# finishes a request. Over-cap connections are accepted from the kernel and
# closed immediately, never queued. This deliberately overlaps with
# Cloudflare's own connection limits — the origin being reachable only through
# Cloudflare is an unverified assumption, and a control that only works when an
# unverified assumption holds is not a control. Only the public listener is
# capped; /metrics and /healthz are not, so a flood cannot blind the operator to
# the flood. Must be at least 1.
AIRBG_MAX_CONNS=4096

# --- Basemap (Phase 3a) ---
#
# Optional. Empty means no basemap: the map renders its data markers over a
# plain background, so local development needs no vendor account.
#
# {key} is substituted with AIRBG_BASEMAP_KEY at startup. The URL's host also
# widens the Content-Security-Policy (connect-src/img-src), so it must be an
# absolute https:// URL with a plain host or host:port — nothing else is
# accepted, because that host reaches a header assembled by concatenation.
#
# The key is PUBLIC by nature: it ships in a URL the browser fetches, so it is
# visible in any visitor's network tab. Domain restriction at the vendor
# (allow-listing this site's origin) is the only real control on it — replace
# the placeholders below with your own vendor's URL and key, never a real one.
# AIRBG_BASEMAP_STYLE_URL=https://tiles.example/style.json?key={key}
# AIRBG_BASEMAP_KEY=replace-with-your-vendor-key
