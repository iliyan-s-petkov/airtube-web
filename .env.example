# Copy to .env for local development: cp .env.example .env
#
# .env is gitignored (and .dockerignore'd, so it never enters an image layer).
# Never commit it, and never reuse the values below outside local development —
# they exist only so `docker compose up` works out of the box against a
# throwaway database. Every value here is a placeholder; no real credential
# belongs in this file or in any committed file.
#
# In production, supply the two secrets through your orchestrator's secret
# mechanism.
#
# Configuration comes from two layers, in this order:
#   1. the YAML file named by AIRBG_CONFIG — this repo's airbg.yaml;
#   2. AIRBG_* environment variables, each overriding one key from that file.
# There is no third layer and nothing is compiled in. A variable name is
# mechanical: AIRBG_ + the dotted key path, uppercased, dots as underscores
# (listen.metrics_addr -> AIRBG_LISTEN_METRICS_ADDR). See docs/configuration.md.

# --- Mandatory ---

# Path to the config file. There is NO fallback path: the loader does not guess
# ./airbg.yaml, because a guessed path is a default in disguise and this project
# keeps no defaults. Unset means every subcommand exits at startup with
# "config: AIRBG_CONFIG is not set". The Docker image already sets this to
# /etc/airbg/airbg.yaml, so it matters when running the binary directly.
AIRBG_CONFIG=./airbg.yaml

# Local Postgres credentials. Read by docker-compose.yml: they initialise the db
# service and compose the connection string below — change all of them together.
POSTGRES_USER=airbg
POSTGRES_PASSWORD=airbg
POSTGRES_DB=airbg

# The PostgreSQL connection string. Environment-only by design: it is a
# credential and airbg.yaml is committed, so writing a database URL (or any
# secret-shaped key: dsn, password, api_key, secret, token, key) into that
# file is a hard rejection at load time, not an ignored value.
# sslmode=disable is acceptable only because this never leaves the compose
# network. Require TLS in production.
AIRBG_DATABASE_URL=postgres://airbg:airbg@db:5432/airbg?sslmode=disable

# --- Overrides (all optional; airbg.yaml already supplies every one) ---
#
# These are commented out because the committed file is the source of truth.
# Uncommenting one overrides exactly that key. None of them has a default: if a
# key were missing from BOTH the file and the environment the binary would
# refuse to start rather than fall back to a zero value — for most of these zero
# is the dangerous setting (an unlimited listener, a disabled rate limit).

# AIRBG_UPSTREAM_URL=https://data.sensor.community/airrohr/v1/filter/country=BG
# AIRBG_UPSTREAM_POLL_INTERVAL=5m

# Public HTTP listener. Keep this on loopback and reach it through a Cloudflare
# tunnel. Binding 0.0.0.0 exposes the origin directly, and a client that reaches
# the origin directly is not covered by any Cloudflare protection — only by the
# in-process token buckets.
# AIRBG_LISTEN_ADDR=127.0.0.1:8080

# Private listener: /metrics and /healthz. Never route this publicly, and never
# make it equal to AIRBG_LISTEN_ADDR — validation rejects that, because sharing
# the address publishes the counters that show an attacker whether their probing
# is being rate limited.
# AIRBG_LISTEN_METRICS_ADDR=127.0.0.1:9090

# Peer ranges whose CF-Connecting-IP header is believed, comma-separated. EMPTY
# MEANS TRUST NOBODY, which is the correct value for local development and for
# any origin not behind Cloudflare. Setting this while the origin is also
# directly reachable lets anyone who can reach it spoof their client IP and
# bypass every rate limit — restrict the origin first, then set this.
# AIRBG_LISTEN_TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,2400:cb00::/32

# Public origin, used for canonical and hreflang links. Must be absolute.
# AIRBG_LISTEN_BASE_URL=http://localhost:8080

# The serve command's two connection pools. They are separate on purpose: the
# collector holds a connection for up to 60s per poll cycle while assigning
# sensors to areas, and while both workloads shared one pool, request handlers
# starved behind it on a schedule. Their sum is what Postgres sees from one
# instance, so raising either is a decision about max_connections. Both must be
# at least 1 — pgxpool reads 0 as "use max(4, numCPU)", so a 0 here would look
# like an explicit choice and silently become the host's core count.
# AIRBG_DATABASE_API_CONNS=8
# AIRBG_DATABASE_COLLECTOR_CONNS=4

# Caps how many requests may be inside a database query at once, across every
# client — a bound on the crowd, not on any one client. Rate limiting alone
# (see the series bucket) permits N well-behaved clients to collectively queue
# more concurrent database work than the pool can serve; the excess would
# otherwise wait inside pgxpool.Acquire holding a goroutine and a socket until
# the 30s WriteTimeout fires, failing most of them at once. Refusing the excess
# immediately (503, with ratelimit.series.retry_after as the hint) keeps the
# site working for everyone else; queueing all of them for 30s is an outage.
# Must be at least 1.
# AIRBG_DATABASE_MAX_INFLIGHT=16

# Caps how many connections EACH internet-facing listener holds open at once —
# the public one, and the tiles one when tiles.* is configured. A bound on
# sockets, not on requests. Nothing else in this process stops tens of thousands
# of mostly-idle connections, each dribbling a header byte every few seconds,
# from exhausting file descriptors and goroutines before a single request
# completes: no rate limiter or admission cap ever sees a connection that never
# finishes a request. Over-cap connections are accepted from the kernel and
# closed immediately, never queued. This deliberately overlaps with
# Cloudflare's own connection limits — the origin being reachable only through
# Cloudflare is an unverified assumption, and a control that only works when an
# unverified assumption holds is not a control. On the tiles listener the
# assumption is not merely unverified but false by design — that port accepts
# the world — and file descriptors are process-wide, so an uncapped tiles
# listener would exhaust them and take the public listener down with it. The
# private listener is NOT capped: /metrics and /healthz sit on loopback, and a
# flood must not also blind the operator to the flood. Must be at least 1.
# AIRBG_LISTEN_MAX_CONNS=4096

# --- Basemap ---
#
# The basemap is self-hosted: three static files generated offline (see
# docs/tiles.md) and served by a third listener. There is no vendor and no key —
# AIRBG_DATABASE_URL above is this project's only secret.
#
# All four keys or none. Empty, as shipped, means no basemap: the map renders
# sensor markers over frontend.empty_basemap_colour and the binary starts two
# listeners instead of three. That is the right setting for local development.
#
# Setting these also requires adding AIRBG_TILES_PUBLIC_URL's origin to
# listen.csp's connect-src, or the browser refuses every basemap fetch and the
# map is silently blank. Validation refuses to start rather than let that ship.
#
# The tiles port is the one port meant to accept the world. The application port
# must accept only Cloudflare's ranges, enforced by a packet filter — see
# docs/tiles.md §6. Skipping that rule is what turns self-hosted tiles into a
# way to find the origin IP.
#
# AIRBG_TILES_ARCHIVE names the PMTiles file inside AIRBG_TILES_DIR, and must
# match the name written into style.json's pmtiles:// source. It carries the
# build date because tile responses are cached immutably for a year:
# regenerating the basemap must produce a NEW filename, or returning visitors
# keep serving themselves the old map. Do not symlink it to a fixed name.
# AIRBG_TILES_ADDR=127.0.0.1:8082
# AIRBG_TILES_DIR=/var/lib/airbg/tiles
# AIRBG_TILES_PUBLIC_URL=https://tiles.airbg.org
# AIRBG_TILES_ARCHIVE=bulgaria-20260815.pmtiles
