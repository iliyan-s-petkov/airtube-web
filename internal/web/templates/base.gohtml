{{define "base"}}<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.MetaDescription}}">
{{if .NoIndex}}<meta name="robots" content="noindex">
{{else}}<link rel="canonical" href="{{.CanonicalURL}}">
{{range .Alternates}}<link rel="alternate" hreflang="{{.Lang}}" href="{{.URL}}">
{{end}}{{with .XDefaultURL}}<link rel="alternate" hreflang="x-default" href="{{.}}">
{{end}}<meta property="og:type" content="website">
<meta property="og:site_name" content="{{.T "seo.title_brand"}}">
<meta property="og:title" content="{{.OGTitle}}">
<meta property="og:description" content="{{.MetaDescription}}">
<meta property="og:url" content="{{.CanonicalURL}}">
<meta property="og:image" content="{{.OGImageURL}}">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="{{.T "seo.image_alt"}}">
<meta property="og:locale" content="{{.OGLocale}}">
{{range .OGLocaleAlternates}}<meta property="og:locale:alternate" content="{{.}}">
{{end}}<meta name="twitter:card" content="summary_large_image">
{{with .JSONLD}}<script type="application/ld+json">{{.}}</script>
{{end}}{{end}}<link rel="icon" href="{{.Static "favicon.svg"}}" type="image/svg+xml">
<link rel="icon" href="{{.Static "favicon-32.png"}}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{.Static "apple-touch-icon.png"}}" sizes="180x180">
{{with .Assets.Style "theme"}}<link rel="stylesheet" href="{{.}}">
{{else}}<link rel="stylesheet" href="{{.Static "theme.css"}}">
{{end}}<link rel="stylesheet" href="{{.Static "app.css"}}">
{{/* Before the stylesheets finish and before anything paints: see the file. */}}
<script src="{{.Static "theme-init.js"}}"></script>
{{with .Assets.Style "main"}}<link rel="stylesheet" href="{{.}}">
{{end}}</head>
<body>
{{/* The masthead brand is the lowercase wordmark of the active language
     (brand.wordmark); the aria-label carries the capitalised product name. */}}
<header class="masthead">
  <a class="masthead__brand" href="{{.Path "/"}}" aria-label="{{.T "seo.title_brand"}}"><img src="{{.Static "favicon.svg"}}" data-logo="kanarche-1b" width="22" height="22" alt="">{{.T "brand.wordmark"}}</a>
  <nav class="masthead__nav" aria-label="{{.T "nav.map"}}">
    <a class="masthead__link" href="{{.Path "/"}}"{{if .OnPath "/"}} aria-current="page"{{end}}>{{.T "nav.map"}}</a>
    <a class="masthead__link" href="{{.Path "/areas"}}"{{if .OnPath "/areas"}} aria-current="page"{{end}}>{{.T "nav.areas"}}</a>
    <a class="masthead__link masthead__link--about" href="{{.Path "/about"}}"{{if .OnPath "/about"}} aria-current="page"{{end}}>{{.T "nav.about"}}</a>
    {{/* Off-site, so it is the one link here that opens in its own tab, with the
         opener severed. The mark is inline rather than a static file: it is the
         only icon on the page and a request would cost more than the bytes. */}}
    <a class="masthead__link masthead__link--source" href="{{.SourceRepoURL}}"
       target="_blank" rel="noopener noreferrer" aria-label="{{.T "nav.source"}}" title="{{.T "nav.source"}}">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
    </a>
    {{/* A <details> rather than the kit's button + aria-expanded pair: the kit
         drives that pair from a script, and this site's pages have to work with
         no JavaScript at all. Native disclosure gives the same three states —
         closed, open, current marked — with no bundle, and the kit's classes
         style it unchanged. */}}
    <details class="langpick">
      <summary class="langpick__btn">
        {{range .LangLinks}}{{if .Current}}{{if .Flag}}<span class="langpick__mark"><img src="{{.Flag}}" width="20" height="12" alt=""></span>{{else}}<span class="langpick__mark langpick__mark--code">{{.Code}}</span>{{end}}<span>{{.Code}}</span>{{end}}{{end}}
        <span class="langpick__caret" aria-hidden="true"></span>
      </summary>
      <ul class="langpick__list">
        {{/* The current language is a <span>, not an <a>: a link to the page the
             reader is already on is a control that does nothing. It is still
             listed, and still marked, so the picker states which language is
             showing rather than leaving the reader to work it out. */}}
        {{range .LangLinks}}<li>{{if .Current}}<span class="langpick__opt" lang="{{.Lang}}" aria-current="true">{{if .Flag}}<span class="langpick__mark"><img src="{{.Flag}}" width="20" height="12" alt=""></span>{{else}}<span class="langpick__mark langpick__mark--code">{{.Code}}</span>{{end}}{{.Name}}</span>{{else}}<a class="langpick__opt" href="{{.URL}}" hreflang="{{.Lang}}" lang="{{.Lang}}">{{if .Flag}}<span class="langpick__mark"><img src="{{.Flag}}" width="20" height="12" alt=""></span>{{else}}<span class="langpick__mark langpick__mark--code">{{.Code}}</span>{{end}}{{.Name}}</a>{{end}}</li>
        {{end}}
        {{/* Phone only (app.css): the header drops both links at that width. */}}
        <li class="langpick__extra langpick__extra--first"><a class="langpick__opt" href="{{.Path "/about"}}"{{if .OnPath "/about"}} aria-current="page"{{end}}>{{.T "nav.about"}}</a></li>
        <li class="langpick__extra"><a class="langpick__opt" href="{{.SourceRepoURL}}" target="_blank" rel="noopener noreferrer">{{.T "nav.source"}}</a></li>
      </ul>
    </details>
    {{/* Hidden until the island unhides it. Without JavaScript there is nothing
         for this control to do — the OS preference already applies and there is
         no storage to write — and a control that does nothing is worse than an
         absent one. */}}
    <details class="langpick" data-island="theme" data-label="{{.T "theme.pick"}}"
             data-auto="{{.T "theme.auto"}}" data-light="{{.T "theme.light"}}"
             data-dark="{{.T "theme.dark"}}" hidden></details>
  </nav>
</header>

{{/* No width of its own: the kit's .frame (data) and .measure (prose) are what
     contain a page's content, and they have to be per-block because the map
     runs full-bleed between two contained blocks. A width on <main> would have
     been a third opinion the two containers then had to fight. */}}
<main class="page">
{{block "main" .}}{{end}}
</main>

<footer class="footer">
  {{/* Brand, three labelled link columns and the profile icons; the bottom bar
       carries the copyright, the donor credit and the snapshot time. The
       disclaimer stays in the brand column on every page: the caveats apply to
       every number the site shows. The language picker lives in the masthead. */}}
  <div class="frame footer__grid">
    <div class="footer__brand">
      <p class="masthead__brand footer__wordmark"><img src="{{.Static "favicon.svg"}}" data-logo="kanarche-1b" width="22" height="22" alt="">{{.T "brand.wordmark"}}</p>
      <p class="footer__tagline">{{.T "footer.brand.tagline"}}</p>
      <p class="footer__disclaimer">{{.T "footer.brand.disclaimer"}}</p>
    </div>
    <nav class="footer__col" aria-labelledby="footer-explore-h">
      <h2 class="footer__heading" id="footer-explore-h">{{.T "footer.explore"}}</h2>
      <ul>
        <li><a href="{{.Path "/"}}">{{.T "nav.map"}}</a></li>
        {{range .FooterAreas}}<li><a href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>
        {{end}}<li><a href="{{.Path "/areas"}}">{{.T "footer.all_areas"}}</a></li>
      </ul>
    </nav>
    <nav class="footer__col" aria-labelledby="footer-sources-h">
      <h2 class="footer__heading" id="footer-sources-h">{{.T "footer.sources"}}</h2>
      {{/* Same tab, opener severed. The licence tag beside each source is the
           minimal attribution; the full terms are on the Licences page. */}}
      <ul>
        <li><a href="{{.AttributionURL "sensor.community"}}" rel="noopener noreferrer">sensor.community<span aria-hidden="true"> ↗</span></a> <span class="footer__lic">ODbL</span></li>
        <li><a href="{{.AttributionURL "eea"}}" rel="noopener noreferrer">ИАОС / EEA<span aria-hidden="true"> ↗</span></a></li>
        <li><a href="{{.AttributionURL "open-meteo"}}" rel="noopener noreferrer">{{.T "footer.src.wind"}}<span aria-hidden="true"> ↗</span></a> <span class="footer__lic">CC BY 4.0</span></li>
        <li><a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer">{{.T "footer.src.osm"}}<span aria-hidden="true"> ↗</span></a> <span class="footer__lic">ODbL</span></li>
      </ul>
    </nav>
    <nav class="footer__col" aria-labelledby="footer-project-h">
      <h2 class="footer__heading" id="footer-project-h">{{.T "footer.project"}}</h2>
      <ul>
        <li><a href="{{.Path "/about"}}">{{.T "nav.about"}}</a></li>
        <li><a href="{{.Path "/about-the-data"}}">{{.T "footer.about_data"}}</a></li>
        <li><a href="{{.SourceRepoURL}}" rel="noopener noreferrer">{{.T "footer.source"}}<span aria-hidden="true"> ↗</span></a></li>
        <li><a href="{{.SourceIssuesURL}}" rel="noopener noreferrer">{{.T "footer.contact"}}<span aria-hidden="true"> ↗</span></a></li>
        <li><a href="https://airbg.info/" rel="noopener noreferrer">{{.T "footer.station"}}<span aria-hidden="true"> ↗</span></a></li>
      </ul>
    </nav>
    {{/* Icons only: each link is named by aria-label. GitHub always shows; the
         others render when a URL is configured (airbg.yaml social:). */}}
    <ul class="footer__social" aria-label="{{.T "footer.social"}}">
      <li><a class="footer__social-link" href="{{.SourceRepoURL}}" rel="noopener noreferrer" aria-label="{{.T "footer.social.github"}}"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg></a></li>
      {{with .FacebookURL}}<li><a class="footer__social-link" href="{{.}}" rel="noopener noreferrer" aria-label="{{$.T "footer.social.facebook"}}"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.5-1.5h1.7V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.7v8h3.2Z"/></svg></a></li>
      {{end}}{{with .LinkedInURL}}<li><a class="footer__social-link" href="{{.}}" rel="noopener noreferrer" aria-label="{{$.T "footer.social.linkedin"}}"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.5 9h3v10h-3V9Zm1.5-4.8a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4ZM9.5 9h2.9v1.4c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7V19h-3v-5c0-1.2 0-2.7-1.7-2.7s-1.9 1.3-1.9 2.6V19h-3V9Z"/></svg></a></li>
      {{end}}
    </ul>
  </div>
  <div class="frame footer__bar">
    <p>© {{.Year}} {{.T "seo.title_brand"}} <span aria-hidden="true">·</span> <a href="{{.Path "/privacy"}}">{{.T "footer.privacy"}}</a> <span aria-hidden="true">·</span> <a href="{{.Path "/licences"}}">{{.T "footer.licences"}}</a></p>
    {{/* Donated, so the credit is owed on every page and at a size that can be
         read — the rest of the footer is 12px caption. */}}
    <p class="footer__sponsor">{{.T "footer.hosting_short"}}
      <a class="link" href="https://hostellation.com/" rel="noopener noreferrer">Hostellation</a></p>
    {{if not .GeneratedAt.IsZero}}<p>{{.T "area.updated"}}: <time datetime="{{.GeneratedAtISO}}" data-local-time>{{.GeneratedAtHuman}}</time></p>{{end}}
  </div>
</footer>
{{template "backToTop" .}}
{{with .Assets.Script "main"}}<script type="module" src="{{.}}"></script>
{{end}}</body>
</html>{{end}}

{{/* The layers menu's copy, in attribute position on the map island. Defined
     once here because the home page and an area page mount the same island and
     the same menu: sixteen attributes written twice is sixteen chances for the
     two pages to end up offering different words for the same layer. The group
     names are the style's own (metadata["airbg:group"] in tools/basemap/style.json)
     and the island turns each into its dataset spelling — see layerLabelKey. */}}
{{/* The averaging selector rides along here for the same reason: one island,
     two pages, one set of words. data-t-windows is positional against
     mapwindow.WINDOW_CHOICES — now, then each published window, coarsest last —
     which is why it is one comma-separated attribute rather than five whose
     names would have to spell "24h" as a dataset key. */}}
{{define "mapLayerLabels"}}data-t-map-title="{{.T "map.label"}}"
     data-t-attribution-toggle="{{.T "map.attribution.toggle"}}"
     data-t-window-label="{{.T "map.window.label"}}"
     data-t-windows="{{.T "map.window.live"}},{{.T "map.window.24h"}},{{.T "map.window.48h"}},{{.T "map.window.7d"}}"
     data-t-play-label="{{.T "map.play.play"}}"
     data-t-pause-label="{{.T "map.play.pause"}}"
     data-t-time-label="{{.T "map.play.time"}}"
     data-t-exit-label="{{.T "map.play.exit"}}"
     data-t-replay-thin="{{.T "map.play.thin"}}"
     data-t-replay-no-history="{{.T "map.play.no_history"}}"
     data-t-speed-label="{{.T "map.play.speed"}}"
     data-t-layers-button="{{.T "map.layers.button"}}"
     data-t-layers-caption="{{.T "map.layers.caption"}}"
     data-t-view-legend="{{.T "map.view.legend"}}"
     data-t-view-basemap="{{.T "map.view.basemap"}}"
     data-t-view-cell-values="{{.T "map.view.cell_values"}}"
     data-t-view-inactive-stations="{{.T "map.view.inactive_stations"}}"
     data-t-view-boundaries="{{.T "map.view.boundaries"}}"
     data-t-view-community-sensors="{{.T "map.view.community_sensors"}}"
     data-t-view-official-stations="{{.T "map.view.official_stations"}}"
     data-t-view-faulty-stations="{{.T "map.view.faulty_stations"}}"
     data-t-not-measured="{{.T "map.view.not_measured"}}"
     data-t-layer-base="{{.T "map.layer.base"}}"
     data-t-layer-water="{{.T "map.layer.water"}}"
     data-t-layer-roads="{{.T "map.layer.roads"}}"
     data-t-layer-street-names="{{.T "map.layer.street_names"}}"
     data-t-layer-buildings="{{.T "map.layer.buildings"}}"
     data-t-layer-places="{{.T "map.layer.places"}}"
     data-t-layer-boundaries="{{.T "map.layer.boundaries"}}"
     data-t-layer-poi-education="{{.T "map.layer.poi_education"}}"
     data-t-layer-poi-health="{{.T "map.layer.poi_health"}}"
     data-t-layer-poi-shop="{{.T "map.layer.poi_shop"}}"
     data-t-layer-poi-transport="{{.T "map.layer.poi_transport"}}"
     data-t-layer-poi-other="{{.T "map.layer.poi_other"}}"{{end}}

{{/* The privacy section's storage list and clear button, shared by /about and
     /about-the-data so the list is rendered from one place. The island needs
     JavaScript and degrades to an inert button without it. */}}
{{define "privacyStorage"}}
<p>{{.T "about.privacy.cookies"}}</p>
<p>{{.T "about.privacy.storage_intro"}}</p>
<table class="storage-table">
  <thead><tr><th scope="col">{{.T "about.privacy.storage_key"}}</th><th scope="col">{{.T "about.privacy.storage_purpose"}}</th></tr></thead>
  <tbody>
{{range .StorageKeys}}    <tr><td><code>{{.Key}}</code></td><td>{{.Purpose}}</td></tr>
{{end}}  </tbody>
</table>
<div class="privacy-clear" data-island="clearsettings" data-keys="{{.StorageKeysCSV}}" data-confirm="{{.T "about.privacy.clear_done"}}">
  <button type="button" class="btn btn--secondary">{{.T "about.privacy.clear_button"}}</button>
  <p class="privacy-clear__note">{{.T "about.privacy.clear_note"}}</p>
  <p data-role="status" role="status" aria-live="polite"></p>
</div>
{{end}}

{{/* The freshness line, on both pages that carry a map. The reload button sits
     inside it on both: on the home page it moved here from the toolbar when the
     controls went onto the map. */}}
{{define "dataFreshness"}}<div data-island="freshness"
     data-button="true"
     data-t-label="{{.T "refresh.button"}}"
     data-t-updated="{{.T "refresh.updated"}}"
     data-t-loading="{{.T "refresh.loading"}}"
     data-t-failed="{{.T "refresh.failed"}}"
     data-t-auto="{{.T "refresh.auto"}}"></div>{{end}}

{{/* The nearby-sensors control's copy, in attribute position on the panel
     island. Defined once because three pages mount that island — home, area and
     the embed — and five attributes written three times is five chances for one
     page to offer different words for the same three lines. */}}
{{define "panelNearbyLabels"}}data-t-nearby-legend="{{.T "chart.nearby.legend"}}"
     data-t-nearby-off="{{.T "chart.nearby.off"}}"
     data-t-nearby-single-only="{{.T "chart.nearby.single_only"}}"
     data-t-nearby-low="{{.T "chart.nearby.low"}}"
     data-t-nearby-median="{{.T "chart.nearby.median"}}"
     data-t-nearby-high="{{.T "chart.nearby.high"}}"{{end}}

{{/* The sensor card's host div: the kit's .place-host slot, carrying the
     panel island's whole translated vocabulary as data-t-* attributes.
     Mounted unchanged by three pages — home, area and the embed — so one
     definition is what keeps a translation key from drifting out of step
     across copies. PanelHostClass is the one real difference: the embed
     caps the card inside its frame, the home page hides it from 1024px. */}}
{{define "sensorCardHost"}}<div class="place-host{{with .PanelHostClass}} {{.}}{{end}}" data-island="panel"
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric="{{.DefaultMetric}}"
     data-period="{{.DefaultPeriod}}"
     data-line-colour="{{.ChartLineColour}}"
     data-compare-colour="{{.ChartCompareColour}}"
     data-t-title="{{.T "panel.title"}}"
     data-t-close="{{.T "panel.close"}}"
     data-t-fav-save="{{.T "panel.favourite.save"}}"
     data-t-fav-remove="{{.T "panel.favourite.remove"}}"
     data-t-no-value="{{.T "panel.no_value"}}"
     data-t-flag-clamped="{{.T "panel.flag.clamped"}}"
     data-t-flag-out-of-range="{{.T "panel.flag.out_of_range"}}"
     data-t-flag-stuck="{{.T "panel.flag.stuck"}}"
     data-t-flag-spatial-outlier="{{.T "panel.flag.spatial_outlier"}}"
     data-t-flag-source-invalid="{{.T "panel.flag.source_invalid"}}"
     data-t-chart-time="{{.T "chart.axis.time"}}"
     data-t-chart-empty="{{.T "chart.empty"}}"
     data-t-chart-unavailable="{{.T "map.error.unavailable"}}"
     data-periods="{{.PeriodsAttr}}"
     data-period-labels="{{.PeriodLabelsAttr}}"
     data-period-short-labels="{{.PeriodShortLabelsAttr}}"
     data-t-more="{{.T "panel.more"}}"
     data-t-share="{{.T "panel.share"}}"
     data-t-embed="{{.T "panel.embed"}}"
     data-t-share-done="{{.T "panel.share_done"}}"
     data-t-embed-done="{{.T "panel.embed_done"}}"
     data-t-copy-failed="{{.T "panel.copy_failed"}}"
     data-t-chart-metric-legend="{{.T "metric.legend"}}"
     data-t-chart-period-legend="{{.T "period.legend"}}"
     data-series-colours="{{.ChartSeriesColours}}"
     data-t-chart-reset="{{.T "chart.reset"}}"
     data-t-period-custom="{{.T "period.custom"}}"
     data-t-period-from="{{.T "period.from"}}"
     data-t-period-to="{{.T "period.to"}}"
     data-t-period-now="{{.T "period.now"}}"
     data-t-chart-range-invalid="{{.T "chart.range_invalid"}}"
     {{template "panelNearbyLabels" .}}
     data-t-details="{{.T "panel.details"}}"
     data-t-detail-devices="{{.T "panel.detail.devices"}}"
     data-t-detail-hardware="{{.T "panel.detail.hardware"}}"
     data-t-detail-since="{{.T "panel.detail.since"}}"
     data-t-detail-updated="{{.T "panel.detail.updated"}}"
     data-t-detail-coords="{{.T "panel.detail.coords"}}"
     data-t-network="{{.T "panel.network"}}"
     data-t-station-code="{{.T "panel.station.code"}}"
     data-t-station-type="{{.T "panel.station.type"}}"
     data-t-station-area="{{.T "panel.station.area"}}"></div>{{end}}

{{/* The figures strip, given a []Readout. Shared because the home page and an
     area page draw the same cells from different sums, and a second copy of
     this markup is how the two start rendering differently. Each cell keeps its
     tier line: no bare numbers (DESIGN.md §9.1). */}}
{{define "readouts"}}<div class="readouts">
{{range .}}  <div class="readout card">
    <span class="readout__label">{{with readoutMetric .Label}}<span class="readout__metric">{{.}} · </span>{{end}}{{readoutRest .Label}}</span>
{{if .Gauge}}    {{/* SVG presentation attributes, not an inline style: style-src is
         'self' with no 'unsafe-inline', so a style attribute would be dropped
         and the arc would never paint. pathLength=100 makes the dash array the
         percentage directly. aria-hidden because the figure inside says it. */}}
    <span class="gauge">
      <svg class="gauge__dial" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
        <circle class="gauge__track" cx="18" cy="18" r="15.9155" fill="none" pathLength="100"></circle>
        <circle class="gauge__arc" cx="18" cy="18" r="15.9155" fill="none" pathLength="100"
                stroke="{{.Colour}}" stroke-dasharray="{{.Percent}} 100"
                transform="rotate(-90 18 18)"></circle>
      </svg>
      <span class="gauge__figure">
        <span class="readout__value">{{.Value}}</span>
        <span class="readout__unit">{{.Unit}}</span>
      </span>
    </span>
{{else}}    <span class="readout__value">{{.Value}}{{with .Unit}} <span class="readout__unit">{{.}}</span>{{end}}</span>
{{end}}    <span class="readout__tier">{{.Tier}}</span>
  </div>
{{end}}</div>{{end}}

{{/* The strip plus the island that swaps it while a sensor is open, given the
     page. The server's cells stay in the DOM and are hidden rather than
     replaced, so closing the sensor restores exactly what was rendered here
     instead of a second implementation's guess at it. */}}
{{define "readouts-island"}}<div data-island="readouts"
     data-sensor-row="{{if .SensorReadoutRow}}on{{else}}off{{end}}"
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric="{{.DefaultMetric}}"
     data-t-high="{{.T "read.sensor.high"}}"
     data-t-low="{{.T "read.sensor.low"}}"
     data-t-median="{{.T "read.sensor.median"}}"
     data-t-this-sensor="{{.T "read.sensor.this"}}"
     data-t-of-total="{{.T "read.sensor.of_total"}}"
     data-t-above="{{.T "read.sensor.above_median"}}"
     data-t-below="{{.T "read.sensor.below_median"}}"
     data-t-at="{{.T "read.sensor.at_median"}}"
     data-t-area-sensors="{{.T "read.sensor.area_sensors"}}"
     data-t-sensors-only="{{.T "read.sensor.sensors_only"}}"
     data-t-source-row="{{.T "area.sources.row"}}"
     data-t-source-row-one="{{.T "area.sources.row_one"}}"
     data-t-source-community="{{.T "source.name.sensor_community"}}"
     data-t-source-official="{{.T "source.name.eea"}}"
  >{{with .StripReadouts}}{{template "readouts" .}}{{end}}</div>{{end}}

{{/* The "more below" strip under the map; web/src/lib/scrollcue.js scrolls to #below-map. */}}
{{define "scrollCue"}}<a class="scroll-cue" href="#below-map" aria-label="{{.T "map.more_below"}}"><svg viewBox="0 0 16 18" width="14" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><path class="scroll-cue__chevron" d="M3 3l5 4.5L13 3"/><path class="scroll-cue__chevron" d="M3 9l5 4.5L13 9"/></svg></a>{{end}}

{{/* Not on the embed page, which has its own layout. The sentinel stands in for the map on pages without one; web/src/lib/backtotop.js. */}}
{{define "backToTop"}}<div class="back-to-top-sentinel" aria-hidden="true"></div>
<button type="button" class="back-to-top" aria-label="{{.T "nav.back_to_top"}}"><svg class="back-to-top__ico" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 10l5-5 5 5"/></svg></button>{{end}}
