{{define "main"}}
<h1>{{.T "site.title"}}</h1>
<p>{{.T "site.tagline"}}</p>

{{/* The list below stays as the no-JavaScript fallback and as the crawlable
     content — a map alone is invisible to a search engine and unusable with
     a screen reader. The MapLibre island mounts on #map beside it, never
     replacing it. */}}
<div id="map" data-island="map"
     data-zoom="7" data-lon="25.4858" data-lat="42.7339"
     data-metric="P2"
     data-basemap="{{.BasemapStyleURL}}"
     data-t-legend="{{.T "map.legend.title"}}"
     data-t-hint="{{.T "map.hint.select_area"}}"
     data-t-rate-limited="{{.T "map.error.rate_limited"}}"
     data-t-unavailable="{{.T "map.error.unavailable"}}"></div>

<h2>{{.T "nav.areas"}}</h2>
<ul class="areas">
{{range .Areas}}
  <li>
    <a href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a>
    {{if .Covered}}<span class="count">{{.SensorCount}} {{$.T "area.sensors"}}</span>
    {{else}}<span class="uncovered">{{$.T "area.no_coverage"}}</span>{{end}}
  </li>
{{end}}
</ul>
{{end}}
